@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <div class="text-center mb-5">
        <h1>Academic Administration System</h1>

        <p class="text-muted">
            Centralized Student and Faculty Record Management
        </p>
    </div>

    <div class="row">

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">

                <div class="card-body text-center">
                    <h3>Student Management</h3>

                    <p>
                        View, add, edit, and delete student records.
                    </p>

                    <a asp-controller="Students"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Students
                    </a>
                </div>

            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">

                <div class="card-body text-center">
                    <h3>Faculty Management</h3>

                    <p>
                        View, add, edit, and delete faculty records.
                    </p>

                    <a asp-controller="Faculty"
                       asp-action="Index"
                       class="btn btn-success">
                        Manage Faculty
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>