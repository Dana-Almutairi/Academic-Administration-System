@model IEnumerable<Academic_Administration_System.Models.Faculty>

@{
    ViewData["Title"] = "Faculty Management";
}

<h2>Faculty Management</h2>
<p>
    <a asp-controller="Faculty"
       asp-action="Create"
       class="btn btn-primary">
        + Add New Faculty Member
    </a>
</p>

<p>
    Manage faculty records in the Academic Administration System.
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Faculty ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var faculty in Model)
        {
            <tr>
                <td>@faculty.FacultyID</td>
                <td>@faculty.FirstName</td>
                <td>@faculty.LastName</td>
                <td>@faculty.Email</td>
                <td>@faculty.Department</td>
                <td>
    <a asp-controller="Faculty"
       asp-action="Edit"
       asp-route-id="@faculty.FacultyID"
       class="btn btn-warning btn-sm">
        Edit
    </a>
    <a asp-controller="Faculty"
   asp-action="Delete"
   asp-route-id="@faculty.FacultyID"
   class="btn btn-danger btn-sm">
    Delete
</a>
</td>
            </tr>
        }
    </tbody>
</table>