@model Academic_Administration_System.Models.Faculty

@{
    ViewData["Title"] = "Delete Faculty Member";
}

<h2>Delete Faculty Member</h2>

<h4 class="text-danger">
    Are you sure you want to delete this faculty member?
</h4>

<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Faculty ID</dt>
        <dd class="col-sm-9">@Model.FacultyID</dd>

        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.FirstName</dd>

        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.LastName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Department</dt>
        <dd class="col-sm-9">@Model.Department</dd>
    </dl>
</div>

<form asp-action="Delete"
      asp-route-id="@Model.FacultyID"
      method="post">

    <button type="submit" class="btn btn-danger">
        Delete Faculty Member
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>